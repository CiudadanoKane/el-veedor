{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/panorama",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/geo",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/noticias",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/noticias-fechas",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/alertas-vencidos",
      "schedule": "25 9 * * *"
    },
    {
      "path": "/api/errores-indice",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/panorama-geo",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/noticias-actores",
      "schedule": "50 9 * * *"
    },
    {
      "path": "/api/concentracion",
      "schedule": "55 9 * * *"
    },
    {
      "path": "/api/evolucion",
      "schedule": "5 10 * * *"
    }
  ],
  "functions": {
    "api/noticias.js": {
      "maxDuration": 300
    },
    "api/noticias-fechas.js": {
      "maxDuration": 300
    },
    "api/geo.js": {
      "maxDuration": 300
    },
    "api/panorama.js": {
      "maxDuration": 300
    },
    "api/panorama-geo.js": {
      "maxDuration": 300
    },
    "api/alertas-vencidos.js": {
      "maxDuration": 300
    },
    "api/errores-indice.js": {
      "maxDuration": 300
    },
    "api/concentracion.js": {
      "maxDuration": 300
    },
    "api/evolucion.js": {
      "maxDuration": 300
    },
    "api/buscar-ia.js": {
      "maxDuration": 30
    },
    "api/noticias-actores.js": {
      "maxDuration": 300
    }
  }
}
