{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|vkShare|redditbot|Pinterestbot|Embedly|Iframely).*" }],
      "destination": "/api/vista-previa?ruta=/"
    },
    {
      "source": "/:ruta((?!api/|assets/)(?!.*\\.(?:png|jpe?g|svg|ico|json|geojson|js|css|txt|xml|webmanifest)$).+)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|vkShare|redditbot|Pinterestbot|Embedly|Iframely).*" }],
      "destination": "/api/vista-previa?ruta=/:ruta"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/panorama",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/geo",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/directorio",
      "schedule": "10 9 * * *"
    },
    {
      "path": "/api/noticias",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/noticias-fechas",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/alertas-vencidos",
      "schedule": "25 9 * * *"
    },
    {
      "path": "/api/errores-indice",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/panorama-geo",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/noticias-actores",
      "schedule": "50 9 * * *"
    },
    {
      "path": "/api/concentracion",
      "schedule": "55 9 * * *"
    },
    {
      "path": "/api/evolucion",
      "schedule": "5 10 * * *"
    }
  ],
  "functions": {
    "api/noticias.js": {
      "maxDuration": 60
    },
    "api/noticias-fechas.js": {
      "maxDuration": 60
    },
    "api/geo.js": {
      "maxDuration": 60
    },
    "api/directorio.js": {
      "maxDuration": 60
    },
    "api/panorama.js": {
      "maxDuration": 60
    },
    "api/panorama-geo.js": {
      "maxDuration": 60
    },
    "api/alertas-vencidos.js": {
      "maxDuration": 60
    },
    "api/errores-indice.js": {
      "maxDuration": 60
    },
    "api/concentracion.js": {
      "maxDuration": 60
    },
    "api/evolucion.js": {
      "maxDuration": 60
    },
    "api/buscar-ia.js": {
      "maxDuration": 30
    },
    "api/vista-previa.js": {
      "maxDuration": 10
    },
    "api/noticias-actores.js": {
      "maxDuration": 60
    }
  }
}
